--- !u!114 &1535118943
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1535118942}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ede61a451a9fdfd49b350144f31ae3f1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueManager: {fileID: 1800511102763012946}
  MiniGameManager: {fileID: 1219878823351116078}
  speaker: {fileID: 2143261603}
  dialogueLines1:
  - Good, now try to set the correct values
  - What? You don't understand how to do it?
  - Just use the goggles and calculate the...
  - Oh wait, I forgot to give them to you
  - Come here, I put them besides me.
  - Goggles are very important, never lose them!
  dialogueLines2:
  - Ok, now use the goggles, the button to turn them on is in the top left corner.
  - Now you see the inside of the machine!
  - Somebody would say it's magic, if they didn't know tehcnologies, hohoho
  - Now you should determine the right formula for this problem
  - You can click on the formula and drag the values from the problem description
    on top of the variables
  - This way you will be able to calcualte the right values
  - And after that you can input them in the machine!
  dialogueLines3:
  - 'Good job! You made it work! '
  - But this won't hold for long
  - Now you need to make all other machines to work
  - They're in the next rooms
  - You can do it, Cal!
  MachineDialogue1: 1
  missionText: {fileID: 1721365964081998203}
  gogglesUI: {fileID: 8099066854920049585}
  gogglesButton: {fileID: 5557696545616594048}
  UIBlueFrame1: {fileID: 4557036482994726655}
  UIBlueFrame2: {fileID: 194006029793011294}
  UIBlueFrame3: {fileID: 2063542801559241529}
  dillan: {fileID: 921384997}
  pvtMachine: {fileID: 396080821}
  goggles: {fileID: 1137240862}
  machineInteractionText: Inspect the machine behind Dillan.
  missionGoggles: Take the goggles on the table beside of Dillan
  gogglesAcquiredText: Inspect the machine and use goggles on it.
  CameraMovement: {fileID: 102068398739489632}
