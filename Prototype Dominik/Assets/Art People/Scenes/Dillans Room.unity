  m_Script: {fileID: 11500000, guid: 0c4a582d038824f41860154262817f1a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  isCharacter: 1
  dialogueLines:
  - 'Cough, cough, cough. '
  - "Ah, Cal, you\u2019ve arrived!  "
  - Praise be to the Three Steam Principles!
  - 'Yeah, I know, it''s freezing here. '
  - That's why I asked for you.
  - I know that we only started learning the thermodynamics....
  - 'but I''m afraid you''ll have to move to practice. '
  - First of all try to launch the Regulator Machine.
  - It's right behind my bed.
  - "You\u2019re our last hope or the building freezes."
